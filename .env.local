# BrightEdge Crawler — Local Development Environment
#
# Copy to .env and run:
#   source .env && uvicorn crawler.api.main:app --reload --port 8000
#
# Or:
#   set -a && source .env && set +a && .venv/bin/uvicorn crawler.api.main:app --reload --port 8000

# Ensure the crawler package is importable
PYTHONPATH=src

# Use local Playwright instead of invoking a Lambda function
HEADLESS_FUNCTION_NAME=LOCAL

# Leave blank to use local filesystem storage instead of AWS
RAW_HTML_BUCKET=
PAGES_TABLE=
JOBS_TABLE=
JOBS_BUCKET=
STATIC_QUEUE_URL=

# Confidence below this triggers headless escalation
CONFIDENCE_THRESHOLD=0.5

# Local storage directory (created automatically)
LOCAL_DATA_DIR=.local_data
